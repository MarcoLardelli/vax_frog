(require :asdf)
(push (merge-pathnames "ops5/" (uiop:getcwd)) asdf:*central-registry*)
(let ((*standard-output* (make-broadcast-stream))) (asdf:load-system :ops5))
(in-package :ops)
;; VAX-OPS5 // is integer division
(defun ari (x)
  (cond ((atom x) 0)
        ((atom (cdr x)) (ari-unit (car x)))
        ((eq (cadr x) '+) (+ (ari-unit (car x)) (ari (cddr x))))
        ((eq (cadr x) '-) (- (ari-unit (car x)) (ari (cddr x))))
        ((eq (cadr x) '*) (* (ari-unit (car x)) (ari (cddr x))))
        ((eq (cadr x) '//) (truncate (ari-unit (car x)) (ari (cddr x))))
        ((eq (cadr x) '\\) (mod (floor (ari-unit (car x))) (floor (ari (cddr x)))))
        (t (%warn '|bad syntax in arithmetic expression | x) 0)))
(defvar *startup* nil)
(defmacro startup (&body forms) `(setf *startup* ',forms))
(defmacro disable (&body z) (declare (ignore z)) nil)
(defun vax-readtable ()
  (let ((rt (copy-readtable nil)))
    ;; 'x' -> symbol x  (VAX OPS5 quoting)
    (set-macro-character #\' (lambda (s c) (declare (ignore c))
       (let ((chars (loop for ch = (read-char s) until (char= ch #\') collect ch)))
         (intern (string-upcase (coerce chars 'string)) :ops))) nil rt)
    (set-syntax-from-char #\, #\a rt)
    (set-macro-character #\{ (lambda (s c) (declare (ignore s c)) '\{) nil rt)
    (set-macro-character #\} (lambda (s c) (declare (ignore s c)) '\}) nil rt)
    (set-macro-character #\^ (lambda (s c) (declare (ignore s c)) '\^) nil rt)
    (set-syntax-from-char #\" #\a rt)
    rt))
(defun load-vax (file)
  (reset-ops)
  (let ((*readtable* (vax-readtable)) (*package* (find-package :ops)) (n 0))
    (with-open-file (in file)
      (loop for form = (read in nil :eof) until (eq form :eof)
            do (incf n) (eval form)))
    (format t "~&;; ~a top-level forms loaded~%" n)))
(defun run-vaxfrog (file)
  (load-vax file)
  (loop for a from -5 to 12 do
    (loop for b from 1 to 3 do
      (dolist (op '(plus minus))
        (eval (list 'make 'zz-arith '\^ 'a a '\^ 'op op '\^ 'b b '\^ 'r (if (eq op 'plus) (+ a b) (- a b)))))))
  (let ((*package* (find-package :ops))) (dolist (f *startup*) (eval f))))
